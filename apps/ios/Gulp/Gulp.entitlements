<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The share extension (Task 9) joins this group to inherit the login
	     cookie, and a widget would join it later. Declared now because adding
	     an App Group after the fact means re-provisioning. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.gulp.shared</string>
	</array>
</dict>
</plist>
